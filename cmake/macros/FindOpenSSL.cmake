# Meneruskan pencarian ke modul FindOpenSSL bawaan CMake modern
include(${CMAKE_ROOT}/Modules/FindOpenSSL.cmake)

if(OPENSSL_FOUND)
  include(EnsureVersion)
  ENSURE_VERSION("1.0" "${OPENSSL_VERSION}" OPENSSL_VERSION_OK)
  if(NOT OPENSSL_VERSION_OK)
    if("${OPENSSL_VERSION}" VERSION_GREATER_EQUAL "3.0.0" AND "${OPENSSL_VERSION}" VERSION_LESS "3.2.0")
      set(OPENSSL_VERSION_OK TRUE)
    endif()
  endif()
  if(NOT OPENSSL_VERSION_OK)
    message(FATAL_ERROR "Found unsupported OpenSSL version ${OPENSSL_VERSION}. Supported versions are 1.1.1 or 3.0.x - 3.1.x.")
  endif()
endif()
